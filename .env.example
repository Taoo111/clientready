# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in secrets.

# --- Postgres (docker-compose) ---
POSTGRES_USER=clientready
POSTGRES_PASSWORD=clientready
POSTGRES_DB=clientready
POSTGRES_PORT=5433
DATABASE_URL=postgresql://clientready:clientready@localhost:5433/clientready
# Production (Supabase): session pooler URL with ?sslmode=require, plus the Supabase CA
# certificate (PEM) in DATABASE_SSL_CA for verified TLS. Pool size kept small for the pooler.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5

# --- API (apps/api) ---
API_PORT=3001
# Origin of the web app, used for CORS
WEB_ORIGIN=http://localhost:3000
# Days after which recordings and transcripts are purged
DATA_RETENTION_DAYS=90
# The running API purges expired data every N hours (0 = only via `pnpm purge-data`)
RETENTION_PURGE_INTERVAL_HOURS=24
# Key for scripts/CLI calling /admin endpoints (header x-admin-key). Min. 24 chars; unset = key access disabled.
# The recruiter panel uses login sessions instead (below).
# Generate one (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
ADMIN_API_KEY=
# Recruiter panel account, created/updated at API startup. Password min. 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Panel session lifetime
SESSION_TTL_HOURS=12
# Unused candidate links expire after this many days
LINK_TTL_DAYS=14
# Max realtime connections per assessment (first connect + reconnects)
MAX_REALTIME_CONNECTS=5
# Recordings storage (local disk, relative to apps/api) and upload size limit
STORAGE_DIR=storage
# Production: STORAGE_DRIVER=supabase with a private Supabase Storage bucket (created on first use)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=recordings
RECORDING_URL_TTL_SEC=3600
MAX_RECORDING_MB=50

# --- Live conversation (OpenAI Realtime) ---
OPENAI_API_KEY=
# Development: mini (cheaper). Production: gpt-realtime-2.1 (follows the client prompt much better;
# also the default when this variable is not set).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Reasoning effort for gpt-realtime-2.x (minimal = fastest, no spoken preambles); set none for gpt-realtime-mini
OPENAI_REALTIME_REASONING_EFFORT=minimal
# Empty = each role's persona voice (marin for women, cedar for men); set to override for all roles
OPENAI_REALTIME_VOICE=
# far_field (laptop/phone mic, default) | near_field (headset) | off
OPENAI_REALTIME_NOISE_REDUCTION=far_field
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Evaluation (provider-independent) ---
# openai (default, uses OPENAI_API_KEY above) or anthropic (uses ANTHROPIC_API_KEY)
EVAL_PROVIDER=openai
# Leave empty for the provider default: gpt-6-sol (openai) / claude-sonnet-5 (anthropic)
EVAL_MODEL=
EVAL_REASONING_EFFORT=high
ANTHROPIC_API_KEY=
# Conversations shorter than this, or with less candidate speech, get "insufficient data"
EVAL_MIN_CONVERSATION_SEC=420
EVAL_MIN_CANDIDATE_SPEECH_SEC=180
# Automatic evaluation after a session: start delay, attempts, first retry delay (doubles)
EVAL_START_DELAY_MS=10000
EVAL_MAX_ATTEMPTS=3
EVAL_RETRY_DELAY_MS=30000

# --- Web (apps/web) ---
# Base URL of the API as seen from the Next.js server
API_URL=http://localhost:3001
# Base URL of the API as seen from the candidate's browser (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional white-label for a customer demo (set on Vercel, never commit customer branding):
# name shown to candidates and in the panel, https logo URL, accent colour (#rrggbb or oklch(...))
NEXT_PUBLIC_CUSTOMER_NAME=
NEXT_PUBLIC_CUSTOMER_LOGO_URL=
NEXT_PUBLIC_BRAND_COLOR=

# --- Error monitoring (Sentry, optional; leave empty to disable) ---
# Create the Sentry organisation in the EU region (DSN host ingest.de.sentry.io).
# No personal data is sent (no IPs, headers, bodies, transcripts; candidate tokens redacted).
# API (Render):
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Web (Vercel); the DSN is inlined into the browser bundle at build time:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Web build only (Vercel), for readable stack traces via source maps; keep the token secret:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
