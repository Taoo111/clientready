generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TargetLevel {
  B1
  B2
  C1
}

enum AssessmentStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  EVALUATED
  FAILED
}

enum Speaker {
  AI
  CANDIDATE
}

enum Recommendation {
  READY
  READY_WITH_CONCERNS
  NOT_READY
}

model Assessment {
  id                 String           @id @default(cuid())
  roleTemplateId     String
  targetLevel        TargetLevel
  candidateName      String
  candidateEmail     String?
  /// Unguessable token used in the candidate link.
  token              String           @unique
  status             AssessmentStatus @default(CREATED)
  consentAt          DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  /// Realtime model and client prompt version used for the conversation (traceability).
  realtimeModel      String?
  promptVersion      String?
  /// Number of realtime connections (first connect + resumes).
  connectCount       Int              @default(0)
  /// Evaluation runs attempted by the automatic job, and the last error (if any).
  evaluationAttempts Int              @default(0)
  evaluationError    String?
  /// Candidate data deleted on request (GDPR): transcript, recordings and reports removed, name anonymised.
  dataDeletedAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  turns      TranscriptTurn[]
  recordings Recording[]
  reports    Report[]
  decisions  RecruiterDecision[]

  @@index([status])
  @@index([createdAt])
}

model TranscriptTurn {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  speaker      Speaker
  text         String
  /// Offset from session start, in milliseconds.
  startedAtMs  Int
  /// Spoken duration (candidate: speech start to stop), when known.
  durationMs   Int?
  seq          Int
  createdAt    DateTime   @default(now())

  @@unique([assessmentId, seq])
}

model Recording {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  storageKey   String
  durationMs   Int?
  mimeType     String
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

model Report {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Report validated against the shared zod schema.
  json          Json
  /// Evaluation provider (openai | anthropic | rules) and model that produced it.
  provider      String
  model         String
  promptVersion String
  createdAt     DateTime   @default(now())

  decisions RecruiterDecision[]

  /// Re-runs (calibration) add reports; the newest one is current.
  @@index([assessmentId, createdAt])
}

/// The recruiter's own verdict on a report (human oversight, EU AI Act). Every change adds a
/// row (audit trail); the newest one is current. Deleted together with the report.
model RecruiterDecision {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reportId     String
  report       Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  verdict      Recommendation
  /// The verdict equals the report's recommendation (calibration data).
  agreesWithAi Boolean
  comment      String?
  /// E-mail of the recruiter, or "admin key" for scripts.
  decidedBy    String
  createdAt    DateTime       @default(now())

  @@index([assessmentId, createdAt])
}

model Recruiter {
  id           String   @id @default(cuid())
  email        String   @unique
  /// argon2id hash
  passwordHash String
  createdAt    DateTime @default(now())

  sessions RecruiterSession[]
}

/// Panel login session; the browser holds the random token (httpOnly cookie), we store its hash.
model RecruiterSession {
  id          String    @id @default(cuid())
  recruiterId String
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  @@index([expiresAt])
}
