generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TargetLevel {
  B1
  B2
  C1
}

enum AssessmentStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  EVALUATED
  FAILED
}

enum Speaker {
  AI
  CANDIDATE
}

model Assessment {
  id                 String           @id @default(cuid())
  roleTemplateId     String
  targetLevel        TargetLevel
  candidateName      String
  candidateEmail     String?
  /// Unguessable token used in the candidate link.
  token              String           @unique
  status             AssessmentStatus @default(CREATED)
  consentAt          DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  /// Realtime model and client prompt version used for the conversation (traceability).
  realtimeModel      String?
  promptVersion      String?
  /// Number of realtime connections (first connect + resumes).
  connectCount       Int              @default(0)
  /// Evaluation runs attempted by the automatic job, and the last error (if any).
  evaluationAttempts Int              @default(0)
  evaluationError    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  turns      TranscriptTurn[]
  recordings Recording[]
  reports    Report[]

  @@index([status])
  @@index([createdAt])
}

model TranscriptTurn {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  speaker      Speaker
  text         String
  /// Offset from session start, in milliseconds.
  startedAtMs  Int
  /// Spoken duration (candidate: speech start to stop), when known.
  durationMs   Int?
  seq          Int
  createdAt    DateTime   @default(now())

  @@unique([assessmentId, seq])
}

model Recording {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  storageKey   String
  durationMs   Int?
  mimeType     String
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

model Report {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Report validated against the shared zod schema.
  json          Json
  /// Evaluation provider (openai | anthropic | rules) and model that produced it.
  provider      String
  model         String
  promptVersion String
  createdAt     DateTime   @default(now())

  /// Re-runs (calibration) add reports; the newest one is current.
  @@index([assessmentId, createdAt])
}

model Recruiter {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
