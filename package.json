{
  "name": "clientready",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @clientready/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @clientready/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @clientready/api db:migrate",
    "db:generate": "pnpm --filter @clientready/api db:generate",
    "db:studio": "pnpm --filter @clientready/api db:studio",
    "test": "pnpm --filter @clientready/shared build && pnpm -r test",
    "create-assessment": "pnpm --filter @clientready/shared build && pnpm --filter @clientready/api create-assessment",
    "test:e2e": "pnpm --filter @clientready/shared build && pnpm --filter @clientready/api test:e2e",
    "purge-data": "pnpm --filter @clientready/shared build && pnpm --filter @clientready/api purge-data",
    "test:eval": "pnpm --filter @clientready/shared build && pnpm --filter @clientready/api test:eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
